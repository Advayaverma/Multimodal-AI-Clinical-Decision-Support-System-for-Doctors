ml/data/upenn_gbm/processed/images/UPENN-GBM-0000[6-9]*
ml/data/upenn_gbm/processed/images/UPENN-GBM-0001*
ml/data/upenn_gbm/processed/images/UPENN-GBM-0002*
ml/data/upenn_gbm/processed/images/UPENN-GBM-0003[1-5]*
